# Required — get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional — spend log (default ~/.typesafe/usage.jsonl)
# TYPESAFE_USAGE_LOG=

# Optional — kit root, if the agents are installed somewhere other than the clone
# TYPESAFE_KIT=

# Optional — agent roster for the agent_router example (default examples/agent-roster.json)
# TYPESAFE_AGENT_ROSTER=
